# Copy to .env (for: docker compose --env-file .env up -d) OR set these as
# Environment Variables on the Coolify resource. See docs/COOLIFY_DEPLOY.md.

# -- required ----------------------------------------------------------
# Admin login (creates the admin user on first boot).
SMART_CAM_ADMIN_PASSWORD=change-me
# Signing key for auth tokens (use a long random string).
SMART_CAM_TOKEN_SECRET=change-me-to-a-long-random-string
# Allowed browser origins for the API (comma-separated).
SMART_CAM_CORS_ORIGINS=*

# -- database (default: SQLite in /app/data) ---------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/smartcam

# -- object storage for clips/thumbs (S3-compatible: R2 / MinIO / AWS) --
# SMART_CAM_S3_BUCKET=
# SMART_CAM_S3_ENDPOINT_URL=
# SMART_CAM_S3_ACCESS_KEY=
# SMART_CAM_S3_SECRET_KEY=

# -- WebRTC TURN (edge cameras behind symmetric NAT) -------------------
# SMART_CAM_TURN_URL=
# SMART_CAM_TURN_USERNAME=
# SMART_CAM_TURN_CREDENTIAL=

# -- optional AI features ----------------------------------------------
# VLM event summaries (OpenAI-compatible endpoint)
# SMART_CAM_OPENAI_API_KEY=

# -- notifications -----------------------------------------------------
# SMART_CAM_NOTIFY_URL=
